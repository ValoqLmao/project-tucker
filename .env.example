# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored and is never shown on the public tracker.

# Voice: https://fish.audio/app/api-keys
FISH_API_KEY=

# Speech-to-text: https://console.deepgram.com  (free credit on signup)
DEEPGRAM_API_KEY=

# LLM: https://venice.ai/settings/api
VENICE_API_KEY=

# Alternative LLM provider (used instead of Venice when set): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model id for whichever provider is active
LLM_MODEL=
